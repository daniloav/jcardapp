# Imagem de runtime do backend — SEM estágio de build.
#
# O JAR é compilado no runner do GitHub Actions e este Dockerfile só empacota o
# resultado. Como a VM (GCP e2-micro) é x86_64, o build é nativo de ponta a
# ponta: sem QEMU, sem cross-compile. Ver .github/workflows/cd.yml.
#
# Espera que `mvn package` já tenha rodado (target/quarkus-app existe).
# Alpine corta ~100 MB da imagem. Só é possível em amd64 — a tag 17-jre-alpine
# não existe para arm64, o que impedia usá-la quando o alvo era a Ampere A1.
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# A ordem segue a estabilidade das camadas: libs mudam pouco, app muda sempre.
COPY target/quarkus-app/lib/     ./lib/
COPY target/quarkus-app/*.jar    ./
COPY target/quarkus-app/app/     ./app/
COPY target/quarkus-app/quarkus/ ./quarkus/

# Alpine usa BusyBox: addgroup/adduser em vez de groupadd/useradd.
RUN addgroup -S -g 1001 appuser \
 && adduser -S -u 1001 -G appuser appuser \
 && chown -R appuser:appuser /app
USER 1001

EXPOSE 8080

# MaxRAMPercentage em vez de -Xmx: o heap acompanha o mem_limit do compose sem
# precisar mexer aqui. 60% de 700 MB deixa ~280 MB para metaspace, threads e
# buffers fora do heap — abaixo disso o container leva OOM kill.
#
# SerialGC, e não G1: a e2-micro tem 1 vCPU (compartilhada), então um coletor
# paralelo só disputa CPU com a própria aplicação e ainda reserva mais memória.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60.0", "-XX:+UseSerialGC", "-jar", "quarkus-run.jar"]

# Copie para .env e preencha. Este arquivo é o modelo; o .env real NÃO é
# versionado e, em produção, vem do secret OCI_ENV_FILE (ver docs/CICD.md).

# ---------------------------------------------------------------- banco --
POSTGRES_DB=jcard
POSTGRES_USER=jcard
POSTGRES_PASSWORD=troque-esta-senha
# IP PRIVADO da VM jcard-db (o CD preenche automaticamente).
JCARD_DB_HOST=10.1.1.x
# Só na VM do banco: faz o Postgres escutar no IP privado, nunca no público.
JCARD_DB_BIND_IP=10.1.1.x

# ------------------------------------------------------- primeiro acesso --
JCARD_ADMIN_NOME=Titular do cartao
JCARD_ADMIN_LOGIN=admin
JCARD_ADMIN_EMAIL=seu-email@gmail.com
JCARD_ADMIN_SENHA=troque-esta-senha-tambem
# Senha dada a cada utilizador novo; o app força a troca no 1º acesso.
JCARD_SENHA_PADRAO=12345678

# ----------------------------------------------------------------- app --
JCARD_APP_URL=https://jcardapp.duckdns.org
# Rollback: aponte para um SHA já publicado no GHCR.
JCARD_IMAGE_TAG=latest

# --------------------------------------------------------------- e-mail --
# SMTP do próprio Gmail com senha de app: o e-mail sai assinado pelo Google e
# passa no DMARC. Relays de terceiros recusam remetente @gmail.com.
#   1) ative a verificação em 2 etapas na conta remetente
#   2) gere uma senha de app em https://myaccount.google.com/apppasswords
#   3) JCARD_MAIL_FROM tem de ser a MESMA conta que autentica no SMTP
JCARD_NOTIF_ENABLED=false
JCARD_MAIL_FROM=JcardApp <sua-conta@gmail.com>
JCARD_SMTP_HOST=smtp.gmail.com
JCARD_SMTP_PORT=587
JCARD_SMTP_USER=sua-conta@gmail.com
JCARD_SMTP_PASS=senha-de-app-de-16-letras

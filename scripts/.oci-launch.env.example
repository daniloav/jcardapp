# Copie para scripts/.oci-launch.env (ignorado pelo git) e preencha.
# Os OCIDs não são segredo, mas identificam a conta — ficam fora do repositório.

COMPARTMENT_ID=ocid1.tenancy.oc1..COLE_AQUI
SUBNET_ID=ocid1.subnet.oc1.sa-saopaulo-1.COLE_AQUI
# Ubuntu 24.04 aarch64 — a A1 é ARM
IMAGE_ID=ocid1.image.oc1.sa-saopaulo-1.COLE_AQUI
AD=xiXO:SA-SAOPAULO-1-AD-1

SSH_KEY_FILE=$HOME/.ssh/jcard_deploy.pub
SLEEP_SECONDS=60
